<Window x:Class="RefaccionariaPOS.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso - Refaccionaria Nueva" Height="560" Width="920"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#14213D" Padding="42">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="REFACCIONARIA" FontSize="34" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Ventas, inventario y corte de caja conectados a Neon PostgreSQL." FontSize="16" Foreground="#B8C4D6" Margin="0,14,0,0" TextWrapping="Wrap"/>
                <Border Width="72" Height="4" Background="#2ECC71" HorizontalAlignment="Left" Margin="0,28,0,28"/>
                <TextBlock Text="Acceso para usuarios autorizados." FontSize="14" Foreground="#E2E8F0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Padding="48">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Iniciar sesión" FontSize="30" FontWeight="Bold" Foreground="#1E272E"/>
                <TextBlock Text="Usa tus credenciales registradas." FontSize="14" Foreground="#6B7785" Margin="0,8,0,30"/>

                <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsuario" Height="42" FontSize="15" Padding="10,8" Margin="0,0,0,18" KeyDown="Credentials_KeyDown"/>

                <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Height="42" FontSize="15" Padding="10,8" Margin="0,0,0,26" KeyDown="Credentials_KeyDown"/>

                <Button Content="Entrar" Height="44" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnEntrar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
