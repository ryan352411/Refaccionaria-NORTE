<Window x:Class="RefaccionariaPOS.Views.InventarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RefaccionariaPOS.Views"
        Title="Inventario de Refacciones"
        Height="660"
        Width="1180"
        MinHeight="580"
        MinWidth="980"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Window.Resources>
        <local:ImagenProductoConverter x:Key="ImagenProductoConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Catalogo de productos" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="btnNuevoProducto" Grid.Column="1" Content="+ Nuevo producto" MinWidth="160" Height="38" Padding="14,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" Click="BtnNuevo_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,15" BorderBrush="#BFDBFE" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Buscar Producto" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtBuscar" Width="270" Height="34" Padding="8,6" TextChanged="TxtBuscar_TextChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Tipo de Pieza" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbCategoria" Width="190" Height="34" Padding="8,5" SelectionChanged="CmbCategoria_SelectionChanged"/>
                </StackPanel>

                <CheckBox x:Name="chkBajoStock"
                          Content="Solo bajo stock"
                          VerticalAlignment="Bottom"
                          Margin="0,0,14,8"
                          FontWeight="SemiBold"
                          Click="ChkBajoStock_Click"/>

                <Button Content="Limpiar filtros"
                        MinWidth="130"
                        Height="34"
                        Padding="12,0"
                        Margin="0,18,0,0"
                        Background="#64748B"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="BtnLimpiarFiltros_Click"/>

                <TextBlock x:Name="lblEstadoCarga"
                           Margin="16,24,0,0"
                           Foreground="#64748B"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="dgInventario" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="White" RowHeight="56" AlternatingRowBackground="#ecf0f1"
                  RowHeaderWidth="0"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  LoadingRow="DgInventario_LoadingRow"
                  MouseDoubleClick="DgInventario_MouseDoubleClick">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ver imágenes" Click="MenuVerImagenes_Click"/>
                    <MenuItem x:Name="menuActualizarStock" Header="Actualizar Stock Físico" Click="MenuActualizarStock_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Imagen" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="46" Height="46" Background="#E2E8F0" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="Click para ver las imágenes del producto"
                                    MouseLeftButtonUp="ImagenProducto_MouseLeftButtonUp">
                                <Grid>
                                    <TextBlock Text="&#x1F4F7;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding TieneImagenes, Converter={StaticResource BoolAVisibilidad}}"/>
                                    <Image Source="{Binding Converter={StaticResource ImagenProductoConverter}}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoBarras}" Width="110"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.2*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Venta" Binding="{Binding TipoVenta}" Width="90"/>
                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="1.4*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=C}" Width="105"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                <DataGridTextColumn Header="Minimo" Binding="{Binding StockMinimo}" Width="80"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoStock}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
