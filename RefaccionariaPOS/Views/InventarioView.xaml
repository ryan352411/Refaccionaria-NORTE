<Window x:Class="RefaccionariaPOS.Views.InventarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RefaccionariaPOS.Views"
        Title="Inventario de Refacciones"
        Height="660"
        Width="1180"
        MinHeight="580"
        MinWidth="980"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="#EEF2F7">

    <Window.Resources>
        <local:ImagenProductoConverter x:Key="ImagenProductoConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>

        <!-- Boton redondeado base con efecto al pasar el mouse -->
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caja de texto redondeada -->
        <Style x:Key="CampoRedondeado" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.4"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borde" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encabezados limpios para la tabla -->
        <Style x:Key="EncabezadoTabla" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,0,10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Celdas sin recuadro de foco -->
        <Style x:Key="CeldaTabla" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Catalogo de productos" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
                <TextBlock Text="Consulta existencias, precios e imagenes de cada refaccion."
                           FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="btnNuevoProducto"
                    Grid.Column="1"
                    Content="+  Nuevo producto"
                    Style="{StaticResource BotonRedondeado}"
                    MinWidth="170"
                    Height="42"
                    Background="#10B981"
                    FontSize="14"
                    HorizontalAlignment="Right"
                    Click="BtnNuevo_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,18"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1E293B" Opacity="0.06" BlurRadius="18" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Buscar producto" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="2,0,0,6"/>
                    <TextBox x:Name="txtBuscar" Width="280" Style="{StaticResource CampoRedondeado}" TextChanged="TxtBuscar_TextChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Tipo de pieza" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="2,0,0,6"/>
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.4" CornerRadius="10">
                        <ComboBox x:Name="cmbCategoria" Width="190" Height="35" Padding="10,5"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbCategoria_SelectionChanged"/>
                    </Border>
                </StackPanel>

                <CheckBox x:Name="chkBajoStock"
                          Content="Solo bajo stock"
                          VerticalAlignment="Bottom"
                          Margin="0,0,16,10"
                          FontWeight="SemiBold"
                          Foreground="#475569"
                          Click="ChkBajoStock_Click"/>

                <Button Content="Limpiar filtros"
                        Style="{StaticResource BotonRedondeado}"
                        MinWidth="130"
                        Height="38"
                        Margin="0,20,0,0"
                        Background="#64748B"
                        Click="BtnLimpiarFiltros_Click"/>

                <TextBlock x:Name="lblEstadoCarga"
                           Margin="18,28,0,0"
                           Foreground="#64748B"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1E293B" Opacity="0.06" BlurRadius="18" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DataGrid x:Name="dgInventario" AutoGenerateColumns="False"
                      IsReadOnly="True" Background="Transparent" RowHeight="56"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource EncabezadoTabla}"
                      CellStyle="{StaticResource CeldaTabla}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      LoadingRow="DgInventario_LoadingRow"
                      MouseDoubleClick="DgInventario_MouseDoubleClick">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ver imágenes" Click="MenuVerImagenes_Click"/>
                        <MenuItem x:Name="menuActualizarStock" Header="Actualizar Stock Físico" Click="MenuActualizarStock_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Imagen" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="46" Height="46" Background="#E2E8F0" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Cursor="Hand" ToolTip="Click para ver las imágenes del producto"
                                        MouseLeftButtonUp="ImagenProducto_MouseLeftButtonUp">
                                    <Grid>
                                        <TextBlock Text="&#x1F4F7;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding TieneImagenes, Converter={StaticResource BoolAVisibilidad}}"/>
                                        <Border CornerRadius="10" ClipToBounds="True">
                                            <Image Source="{Binding Converter={StaticResource ImagenProductoConverter}}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoBarras}" Width="110"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.2*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Categoria}" Width="130"/>
                    <DataGridTextColumn Header="Venta" Binding="{Binding TipoVenta}" Width="90"/>
                    <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="1.4*"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=C}" Width="105"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                    <DataGridTextColumn Header="Minimo" Binding="{Binding StockMinimo}" Width="80"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoStock}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
