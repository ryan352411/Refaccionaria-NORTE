<Window x:Class="RefaccionariaPOS.Views.AuditoriaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Auditoría" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="15" Background="White" Padding="15">
            <TextBlock Text="Filtros de Auditoría" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Tabla" FontSize="11" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbTabla" SelectionChanged="CmbTabla_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Operación" FontSize="11" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbOperacion" SelectionChanged="CmbOperacion_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Período" FontSize="11" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbDias" SelectionChanged="CmbDias_SelectionChanged"/>
                </StackPanel>

                <Button Grid.Column="3" x:Name="btnExportar" Click="BtnExportar_Click"
                        Content="📊 Exportar CSV" Margin="15,20,0,0"
                        Padding="10,8" Background="#3B82F6" Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </StackPanel>

        <!-- DataGrid de auditoría -->
        <DataGrid Grid.Row="1" x:Name="dgAuditoria" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="15" Background="White"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" RowHeight="35">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaOperacion, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="100"/>
                <DataGridTextColumn Header="Tabla" Binding="{Binding Tabla}" Width="100"/>
                <DataGridTextColumn Header="Operación" Binding="{Binding Operacion}" Width="80"/>
                <DataGridTextColumn Header="ID Registro" Binding="{Binding RegistroId}" Width="80"/>
                <DataGridTextColumn Header="Campo" Binding="{Binding Campo}" Width="120"/>
                <DataGridTextColumn Header="Valor Anterior" Binding="{Binding ValorAnterior}" Width="120"/>
                <DataGridTextColumn Header="Valor Nuevo" Binding="{Binding ValorNuevo}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Operacion}" Value="DELETE">
                            <Setter Property="Background" Value="#FEE2E2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Operacion}" Value="INSERT">
                            <Setter Property="Background" Value="#DCFCE7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Operacion}" Value="UPDATE">
                            <Setter Property="Background" Value="#FEF3C7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>
