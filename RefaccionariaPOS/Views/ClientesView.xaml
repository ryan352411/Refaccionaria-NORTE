<Window x:Class="RefaccionariaPOS.Views.ClientesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes Frecuentes"
        Height="640"
        Width="980"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Clientes Frecuentes" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Registra clientes, telefono, puntos y notas para seguimiento." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock x:Name="lblModo" Text="Nuevo cliente" FontSize="18" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Telefono" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTelefono" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Correo" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCorreo" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Puntos" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPuntos" Text="0" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Notas" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNotas" Height="90" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Button Content="Guardar" Height="40" Margin="0,0,6,0" Background="#0F766E" Foreground="White" FontWeight="Bold" Click="BtnGuardar_Click"/>
                        <Button Content="Nuevo" Height="40" Margin="6,0,0,0" Background="#64748B" Foreground="White" FontWeight="Bold" Click="BtnNuevo_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button Content="Eliminar" DockPanel.Dock="Right" Width="100" Height="34" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Click="BtnEliminar_Click"/>
                        <TextBox x:Name="txtBuscar" Width="280" Height="34" Padding="8,6" HorizontalAlignment="Left" TextChanged="TxtBuscar_TextChanged"/>
                    </DockPanel>

                    <DataGrid x:Name="dgClientes"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="DgClientes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="130"/>
                            <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="170"/>
                            <DataGridTextColumn Header="Puntos" Binding="{Binding Puntos}" Width="80"/>
                            <DataGridTextColumn Header="Alta" Binding="{Binding FechaAlta, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
