<Window x:Class="RefaccionariaPOS.Views.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro de venta"
        Height="500"
        Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#F8FAFC">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECFDF5" CornerRadius="10" Padding="16" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Total a cobrar" FontSize="13" Foreground="#047857" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblTotal" Text="$0.00" FontSize="34" FontWeight="Black" Foreground="#065F46" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Cliente frecuente" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbClientes" Height="34" DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,0,0,14"/>

                <TextBlock Text="Metodo de pago" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbMetodoPago" Height="34" SelectedIndex="0" SelectionChanged="CmbMetodoPago_SelectionChanged" Margin="0,0,0,14">
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Tarjeta"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

                <TextBlock Text="Efectivo recibido" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="txtEfectivoRecibido" Height="38" FontSize="18" FontWeight="Bold" TextAlignment="Center" Padding="5,6" TextChanged="TxtEfectivoRecibido_TextChanged" Margin="0,0,0,12"/>

                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#BFDBFE" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="Cambio" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblCambio" Text="$0.00" DockPanel.Dock="Right" FontSize="22" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,18,0,0">
            <Button Content="Cancelar" Height="46" Margin="0,0,6,0" Background="#E2E8F0" Foreground="#334155" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button x:Name="btnConfirmar" Content="Confirmar venta" Height="46" Margin="6,0,0,0" Background="#2ECC71" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsDefault="True" Click="BtnConfirmar_Click"/>
        </UniformGrid>
    </Grid>
</Window>
