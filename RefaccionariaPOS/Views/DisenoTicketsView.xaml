<Window x:Class="RefaccionariaPOS.Views.DisenoTicketsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diseño de Tickets"
        Height="680"
        Width="1020"
        MinHeight="580"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Diseño de Tickets" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Personaliza el encabezado y el pie de cada tipo de ticket. La vista previa muestra cómo saldrá en la impresora." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tipo de ticket" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbTipo" Grid.Row="1" Height="38" FontSize="14" Padding="8,6" Margin="0,0,0,16" SelectionChanged="CmbTipo_SelectionChanged">
                        <ComboBoxItem Content="Ticket de venta" Tag="venta" IsSelected="True"/>
                        <ComboBoxItem Content="Corte de caja" Tag="corte"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Encabezado (datos del negocio)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtEncabezado" Grid.Row="3"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,0,0,14"
                             TextChanged="Plantilla_TextChanged"/>

                    <TextBlock Grid.Row="4" Text="Pie (mensajes finales)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPie" Grid.Row="5"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,0,0,10"
                             TextChanged="Plantilla_TextChanged"/>

                    <TextBlock Grid.Row="6"
                               Text="Cada línea se centra automáticamente en el ticket. El texto que sobre del ancho elegido se recorta; el ancho se cambia arrastrando los bordes de la vista previa."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <UniformGrid Grid.Row="7" Columns="3">
                        <Button Content="Guardar" Height="42" Margin="0,0,6,0" Background="#0F766E" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnGuardar_Click"/>
                        <Button Content="Restaurar predeterminado" Height="42" Margin="3,0,3,0" Background="#64748B" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="BtnRestaurar_Click"/>
                        <Button Content="Imprimir prueba" Height="42" Margin="6,0,0,0" Background="#2980B9" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="BtnImprimirPrueba_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#334155" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Vista previa de impresión" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblAncho" Grid.Row="1" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,12" HorizontalAlignment="Center"
                               Text="Ancho: 40 caracteres · arrastra los bordes del ticket para cambiarlo"/>

                    <ScrollViewer x:Name="scrollVistaPrevia" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Border x:Name="bordeTicket" Background="White" Width="320" Padding="14,18" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="2"
                                MouseMove="BordeTicket_MouseMove"
                                MouseLeftButtonDown="BordeTicket_MouseLeftButtonDown"
                                MouseLeftButtonUp="BordeTicket_MouseLeftButtonUp"
                                MouseLeave="BordeTicket_MouseLeave">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                            </Border.Effect>
                            <TextBlock x:Name="txtVistaPrevia"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       Foreground="#1E272E"
                                       TextWrapping="NoWrap"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
