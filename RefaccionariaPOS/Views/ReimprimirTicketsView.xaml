<Window x:Class="RefaccionariaPOS.Views.ReimprimirTicketsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reimprimir Tickets"
        Height="620"
        Width="980"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Reimprimir Tickets" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Busca una venta y manda el ticket nuevamente a la impresora predeterminada." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <Button Content="Actualizar" DockPanel.Dock="Right" MinWidth="110" Height="34" Padding="12,0" Background="#2980B9" Foreground="White" FontWeight="SemiBold" Click="BtnActualizar_Click"/>
                <TextBox x:Name="txtBuscar" Width="320" Height="34" Padding="8,6" TextChanged="TxtBuscar_TextChanged"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="dgVentas"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="90"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="130"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Vendedor}" Width="140"/>
                <DataGridTextColumn Header="Metodo" Binding="{Binding MetodoPago}" Width="*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="lblEstado" VerticalAlignment="Center" Foreground="#64748B"/>
            <Button Content="Reimprimir seleccionado" DockPanel.Dock="Right" MinWidth="190" Height="40" Padding="14,0" Background="#0F766E" Foreground="White" FontWeight="Bold" Click="BtnReimprimir_Click"/>
        </DockPanel>
    </Grid>
</Window>
