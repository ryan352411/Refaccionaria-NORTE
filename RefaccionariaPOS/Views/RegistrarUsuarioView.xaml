<Window x:Class="RefaccionariaPOS.Views.RegistrarUsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion de personal"
        Height="720"
        Width="1220"
        MinHeight="620"
        MinWidth="1040"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestion de personal" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Alta de usuarios, consulta de accesos y permisos registrados." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Nuevo usuario" FontSize="18" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,0,18"/>

                    <TextBlock Text="Nombre de usuario" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNuevoUsuario" Height="36" Padding="8,7" Margin="0,0,0,16"/>

                    <TextBlock Text="Contrasena" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtNuevaPassword" Height="36" Padding="8,7" Margin="0,0,0,16"/>

                    <TextBlock Text="Rol" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbRol" Height="36" Padding="8,6" SelectedIndex="0" Margin="0,0,0,22">
                        <ComboBoxItem Content="Vendedor"/>
                        <ComboBoxItem Content="Encargado de Inventario"/>
                        <ComboBoxItem Content="SuperAdmin"/>
                    </ComboBox>

                    <Button Content="Guardar usuario" Height="42" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnGuardarUsuario_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Usuarios registrados" FontSize="18" FontWeight="Bold" Foreground="#1E272E" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Eliminar usuario" MinWidth="130" Height="36" Padding="12,0" Background="#E74C3C" Foreground="White" Margin="0,0,10,0" Click="BtnEliminarUsuario_Click"/>
                        <Button Grid.Column="2" Content="Actualizar" MinWidth="105" Height="36" Padding="12,0" Background="#2980B9" Foreground="White" Click="BtnActualizar_Click"/>
                    </Grid>

                    <DataGrid x:Name="dgUsuarios" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DgUsuarios_SelectionChanged" RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="180"/>
                            <DataGridTextColumn Header="Fecha de alta" Binding="{Binding FechaAlta, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Permisos" FontSize="18" FontWeight="Bold" Foreground="#1E272E"/>
                        <TextBlock x:Name="lblUsuarioPermisos" Text="Selecciona un usuario" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstPermisos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Habilitado}" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Guardar permisos" Height="42" Background="#0F766E" Foreground="White" FontWeight="Bold" Click="BtnGuardarPermisos_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
