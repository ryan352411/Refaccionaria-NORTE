<Window x:Class="RefaccionariaPOS.Views.ArticulosComunesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Articulos Comunes"
        Height="680"
        Width="1040"
        MinHeight="600"
        MinWidth="920"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Articulos Comunes" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Venta rapida sin codigo de barras: nombre, cantidad y precio." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,18,0" BorderBrush="#FED7AA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Agregar articulo" FontSize="18" FontWeight="Bold" Foreground="#9A3412" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNombre" Height="38" Padding="8,7" Margin="0,0,0,14" KeyDown="CamposArticulo_KeyDown"/>

                    <TextBlock Text="Cantidad" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtCantidad" Text="1" Height="38" Padding="8,7" Margin="0,0,0,14" KeyDown="CamposArticulo_KeyDown"/>

                    <TextBlock Text="Precio" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPrecio" Height="38" Padding="8,7" Margin="0,0,0,18" KeyDown="CamposArticulo_KeyDown"/>

                    <Button Content="Agregar a la venta" Height="42" Background="#F97316" Foreground="White" FontWeight="Bold" Click="BtnAgregar_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,18,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Articulos en venta" FontSize="18" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,0,14"/>

                    <DataGrid x:Name="dgArticulos"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              KeyDown="DgArticulos_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Articulo" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="95"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat={}{0:C}}" Width="110"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18" BorderBrush="#BBF7D0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cobro" FontSize="18" FontWeight="Bold" Foreground="#14532D" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Cliente frecuente" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbClientes" DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,0,0,14"/>

                            <TextBlock Text="Metodo de pago" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbMetodoPago" SelectedIndex="0" SelectionChanged="CmbMetodoPago_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Efectivo"/>
                                <ComboBoxItem Content="Tarjeta"/>
                                <ComboBoxItem Content="Transferencia"/>
                            </ComboBox>

                            <TextBlock Text="Efectivo recibido" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEfectivoRecibido" Height="38" Padding="8,7" TextChanged="TxtEfectivoRecibido_TextChanged" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="Cambio" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock x:Name="lblCambio" Text="$0.00" DockPanel.Dock="Right" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Separator Margin="0,0,0,14"/>

                            <TextBlock Text="Impresora de tickets" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbImpresoras" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,8">
                                <CheckBox x:Name="chkImprimirTicket" Content="Imprimir al cobrar" IsChecked="True" VerticalAlignment="Center"/>
                                <Button x:Name="btnProbarImpresora" Content="Probar" DockPanel.Dock="Right" Width="82" Height="32" Background="#06B6D4" Foreground="White" FontWeight="Bold" Click="BtnProbarImpresora_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Separator Margin="0,8,0,10"/>
                        <DockPanel>
                            <TextBlock Text="Total" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotal" Text="$0.00" DockPanel.Dock="Right" FontSize="28" FontWeight="Black" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Button Content="Registrar venta" Height="46" Margin="0,10,0,0" Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnRegistrarVenta_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="lblEstado" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Content="Quitar seleccionado" DockPanel.Dock="Right" MinWidth="150" Height="38" Padding="14,0" Background="#64748B" Foreground="White" FontWeight="Bold" Click="BtnQuitar_Click"/>
        </DockPanel>
    </Grid>
</Window>
