<Window x:Class="RefaccionariaPOS.Views.ImagenesProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagenes del producto"
        Height="560"
        Width="660"
        MinHeight="420"
        MinWidth="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblNombreProducto"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                Margin="0,12,0,12">
            <Grid>
                <Image x:Name="imgProducto" Stretch="Uniform" Margin="10"/>
                <TextBlock x:Name="lblEstado"
                           Text="Cargando imagenes..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAnterior"
                    Grid.Column="0"
                    Content="&#x25C0; Anterior"
                    MinWidth="110"
                    Height="34"
                    Padding="12,0"
                    Background="#64748B"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="BtnAnterior_Click"/>

            <TextBlock x:Name="lblContador"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <Button x:Name="btnSiguiente"
                    Grid.Column="2"
                    Content="Siguiente &#x25B6;"
                    MinWidth="110"
                    Height="34"
                    Padding="12,0"
                    Background="#64748B"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="BtnSiguiente_Click"/>
        </Grid>
    </Grid>
</Window>
