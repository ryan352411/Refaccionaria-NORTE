<Window x:Class="RefaccionariaPOS.Views.ImagenesProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagenes del producto"
        Height="560"
        Width="660"
        MinHeight="420"
        MinWidth="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7">

    <Window.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblNombreProducto"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Margin="0,12,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#1E293B" Opacity="0.06" BlurRadius="18" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Image x:Name="imgProducto" Stretch="Uniform" Margin="10"/>
                <TextBlock x:Name="lblEstado"
                           Text="Cargando imagenes..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAnterior"
                    Grid.Column="0"
                    Content="&#x25C0;  Anterior"
                    Style="{StaticResource BotonRedondeado}"
                    MinWidth="110"
                    Height="38"
                    Background="#64748B"
                    IsEnabled="False"
                    Click="BtnAnterior_Click"/>

            <TextBlock x:Name="lblContador"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#334155"/>

            <Button x:Name="btnSiguiente"
                    Grid.Column="2"
                    Content="Siguiente  &#x25B6;"
                    Style="{StaticResource BotonRedondeado}"
                    MinWidth="110"
                    Height="38"
                    Background="#64748B"
                    IsEnabled="False"
                    Click="BtnSiguiente_Click"/>
        </Grid>
    </Grid>
</Window>
