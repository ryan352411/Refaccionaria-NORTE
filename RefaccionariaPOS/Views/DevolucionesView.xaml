<Window x:Class="RefaccionariaPOS.Views.DevolucionesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devoluciones"
        Height="640"
        Width="1040"
        MinHeight="560"
        MinWidth="900"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Devoluciones" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Selecciona una venta para devolverla completa y restaurar el inventario." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button Content="Actualizar" DockPanel.Dock="Right" MinWidth="115" Height="34" Padding="12,0" Background="#2980B9" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnActualizar_Click"/>
                <TextBox x:Name="txtBuscar" Width="340" Height="34" Padding="8,6" TextChanged="TxtBuscar_TextChanged"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="dgVentas"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Background="White"
                  RowHeight="34"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F8FAFC"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Vendedor}" Width="130"/>
                <DataGridTextColumn Header="Metodo" Binding="{Binding MetodoPago}" Width="*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="lblEstado" VerticalAlignment="Center" Foreground="#64748B"/>
            <Button Content="Registrar devolucion"
                    DockPanel.Dock="Right"
                    MinWidth="190"
                    Height="40"
                    Padding="14,0"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="BtnRegistrarDevolucion_Click"/>
        </DockPanel>
    </Grid>
</Window>
