<Window x:Class="RefaccionariaPOS.Views.RegistrarProductoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar refaccion"
        Height="780"
        Width="620"
        MinHeight="620"
        MinWidth="540"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="lblModo" Text="NUEVO PRODUCTO" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                <TextBlock Text="Escanea o escribe el codigo de barras. Si ya existe, se rellenan los datos." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" TextAlignment="Center"/>

                <TextBlock Text="Codigo de barras:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCodigo" Height="36" Padding="8,7" KeyDown="TxtCodigo_KeyDown" LostFocus="TxtCodigo_LostFocus"/>

                <TextBlock Text="Nombre del producto:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNombre" Height="36" Padding="8,7"/>

                <TextBlock Text="Tipo de pieza:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbCategoria" Height="38" Padding="8,6" IsEditable="True"/>

                <TextBlock Text="Descripcion:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDescripcion" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"/>

                <TextBlock Text="Imagen del producto:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtImagenUrl" Height="36" Padding="8,7" IsReadOnly="True"/>
                    <Button Grid.Column="1"
                            Content="Seleccionar"
                            Height="36"
                            MinWidth="112"
                            Margin="8,0,0,0"
                            Background="#2980B9"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnSeleccionarImagen_Click"/>
                </Grid>

                <TextBlock Text="Forma de venta:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbTipoVenta" Height="38" Padding="8,6" SelectedIndex="0">
                    <ComboBoxItem Content="Unidad"/>
                    <ComboBoxItem Content="Granel"/>
                </ComboBox>

                <TextBlock Text="Costo proveedor ($):" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCosto" Height="36" Padding="8,7"/>

                <TextBlock Text="Precio venta ($):" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPrecioVenta" Height="36" Padding="8,7"/>

                <TextBlock Text="Stock minimo:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtStockMinimo" Height="36" Padding="8,7" Text="5"/>

                <TextBlock x:Name="lblStockCaption" Text="Stock inicial:" Margin="0,10,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtStock" Height="36" Padding="8,7"/>

                <UniformGrid Columns="2" Margin="0,20,0,0">
                    <Button x:Name="btnGuardar" Content="Guardar" Background="#27AE60" Foreground="White" FontWeight="Bold" Height="42" Margin="5" Click="BtnGuardar_Click" Cursor="Hand"/>
                    <Button Content="Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" Height="42" Margin="5" Click="BtnCancelar_Click" Cursor="Hand"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
