<Window x:Class="RefaccionariaPOS.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - RefaxManager"
        Height="700"
        Width="1220"
        MinHeight="640"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Window.Resources>
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#243B55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14213D" Padding="22,16,22,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RefaxManager" FontSize="26" FontWeight="Black" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Punto de venta" FontSize="12" Foreground="#B8C4D6"/>
                            <TextBlock Text="  -  " FontSize="12" Foreground="#6B7B93"/>
                            <TextBlock Text="Rol activo: " FontSize="12" Foreground="#B8C4D6"/>
                            <TextBlock x:Name="lblRolVisual" Text="Cargando..." FontSize="12" FontWeight="Bold" Foreground="#2ECC71"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="btnUsuarioActual"
                            Grid.Column="1"
                            Height="40"
                            MinWidth="170"
                            MaxWidth="240"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Background="#0F766E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnUsuarioActual_Click"/>

                    <Button x:Name="btnNotificaciones"
                            Grid.Column="2"
                            Width="104"
                            Height="40"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnNotificaciones_Click">
                        <Grid>
                            <TextBlock Text="Alertas" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border x:Name="brdContadorAlertas"
                                    MinWidth="22"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="White"
                                    Padding="5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-7,-8,0">
                                <TextBlock x:Name="lblContadorAlertas"
                                           Text="0"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#DC2626"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button x:Name="btnVenta" Content="Punto de Venta" Style="{StaticResource TopNavButton}" Background="#2ECC71" FontWeight="Bold" Click="BtnVenta_Click"/>
                    <Button x:Name="btnArticulosComunes" Content="Articulos Comunes" Style="{StaticResource TopNavButton}" Background="#F97316" FontWeight="Bold" Click="BtnArticulosComunes_Click"/>
                    <Button x:Name="btnInventario" Content="Inventario" Style="{StaticResource TopNavButton}" Click="BtnInventario_Click"/>
                    <Button x:Name="btnHistorial" Content="Historial de Ventas" Style="{StaticResource TopNavButton}" Click="BtnHistorial_Click"/>
                    <Button x:Name="btnDevoluciones" Content="Devoluciones" Style="{StaticResource TopNavButton}" Click="BtnDevoluciones_Click"/>
                    <Button x:Name="btnClientes" Content="Clientes Frecuentes" Style="{StaticResource TopNavButton}" Click="BtnClientes_Click"/>
                    <Button x:Name="btnReimprimir" Content="Reimprimir Tickets" Style="{StaticResource TopNavButton}" Click="BtnReimprimir_Click"/>
                    <Button x:Name="btnCorteCaja" Content="Corte de Caja" Style="{StaticResource TopNavButton}" Background="#2980B9" FontWeight="Bold" Click="BtnCorteCaja_Click"/>
                    <Button x:Name="btnUsuarios" Content="Gestionar Personal" Style="{StaticResource TopNavButton}" Background="#6C5CE7" FontWeight="Bold" Click="BtnUsuarios_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="contentHost" Grid.Row="1">
            <ContentControl.Content>
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,4,0,24">
                        <TextBlock Text="Panel de operacion" FontSize="30" FontWeight="Bold" Foreground="#1E272E"/>
                        <TextBlock x:Name="lblSubtitulo"
                                   Text="Selecciona una opcion del menu superior para empezar."
                                   FontSize="14"
                                   Foreground="#6B7785"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top" Height="160">
                        <Border Background="White" CornerRadius="8" Margin="10" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Acceso rapido" FontSize="17" FontWeight="Bold" Foreground="#1E272E"/>
                                <TextBlock Text="El escaner de barras esta activo en la caja de cobro." FontSize="13" Foreground="#7F8C8D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Margin="10" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Base de datos" FontSize="17" FontWeight="Bold" Foreground="#1E272E"/>
                                <TextBlock Text="Conexion con Neon PostgreSQL configurada para ventas e inventario." FontSize="13" Foreground="#7F8C8D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </ContentControl.Content>
        </ContentControl>
    </Grid>
</Window>
