<Window x:Class="RefaccionariaPOS.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - RefaxManager"
        Height="700"
        Width="1220"
        MinHeight="640"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F5F8">

    <Window.Resources>
        <Style x:Key="TopNavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#243B55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14213D" Padding="22,16,22,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RefaxManager" FontSize="26" FontWeight="Black" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Punto de venta" FontSize="12" Foreground="#B8C4D6"/>
                            <TextBlock Text="  -  " FontSize="12" Foreground="#6B7B93"/>
                            <TextBlock Text="Rol activo: " FontSize="12" Foreground="#B8C4D6"/>
                            <TextBlock x:Name="lblRolVisual" Text="Cargando..." FontSize="12" FontWeight="Bold" Foreground="#2ECC71"/>
                            <TextBlock x:Name="lblEstadoConexion"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#F59E0B"
                                       Margin="14,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="btnUsuarioActual"
                            Grid.Column="1"
                            Height="40"
                            MinWidth="170"
                            MaxWidth="240"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Background="#0F766E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnUsuarioActual_Click"/>

                    <Button x:Name="btnNotificaciones"
                            Grid.Column="2"
                            Width="104"
                            Height="40"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnNotificaciones_Click">
                        <Grid>
                            <TextBlock Text="Alertas" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border x:Name="brdContadorAlertas"
                                    MinWidth="22"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="White"
                                    Padding="5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-7,-8,0">
                                <TextBlock x:Name="lblContadorAlertas"
                                           Text="0"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#DC2626"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="btnCerrarSesion"
                            Grid.Column="3"
                            Content="Cerrar sesion"
                            Height="40"
                            MinWidth="120"
                            Padding="14,0"
                            Margin="10,0,0,0"
                            Background="#475569"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrarSesion_Click"/>

                </Grid>

                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button x:Name="btnVenta" Content="Punto de Venta" Style="{StaticResource TopNavButton}" Background="#2ECC71" FontWeight="Bold" Click="BtnVenta_Click"/>
                    <Button x:Name="btnArticulosComunes" Content="Articulos Comunes" Style="{StaticResource TopNavButton}" Background="#F97316" FontWeight="Bold" Click="BtnArticulosComunes_Click"/>
                    <Button x:Name="btnInventario" Content="Inventario" Style="{StaticResource TopNavButton}" Click="BtnInventario_Click"/>
                    <Button x:Name="btnHistorial" Content="Historial de Ventas" Style="{StaticResource TopNavButton}" Click="BtnHistorial_Click"/>
                    <Button x:Name="btnDevoluciones" Content="Devoluciones" Style="{StaticResource TopNavButton}" Click="BtnDevoluciones_Click"/>
                    <Button x:Name="btnClientes" Content="Clientes Frecuentes" Style="{StaticResource TopNavButton}" Click="BtnClientes_Click"/>
                    <Button x:Name="btnReimprimir" Content="Reimprimir Tickets" Style="{StaticResource TopNavButton}" Click="BtnReimprimir_Click"/>
                    <Button x:Name="btnCorteCaja" Content="Corte de Caja" Style="{StaticResource TopNavButton}" Background="#2980B9" FontWeight="Bold" Click="BtnCorteCaja_Click"/>
                    <Button x:Name="btnUsuarios" Content="Gestionar Personal" Style="{StaticResource TopNavButton}" Background="#6C5CE7" FontWeight="Bold" Click="BtnUsuarios_Click"/>
                    <Button x:Name="btnTelegram" Content="Avisos Telegram" Style="{StaticResource TopNavButton}" Background="#229ED9" FontWeight="Bold" Click="BtnTelegram_Click"/>
                    <Button x:Name="btnDisenoTickets" Content="Diseño de Tickets" Style="{StaticResource TopNavButton}" Background="#8E44AD" FontWeight="Bold" Click="BtnDisenoTickets_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="contentHost" Grid.Row="1"/>

        <Grid x:Name="vistaInicio" Grid.Row="1" Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,4,0,18">
                        <TextBlock Text="Buscar productos" FontSize="30" FontWeight="Bold" Foreground="#1E272E"/>
                        <TextBlock x:Name="lblSubtitulo"
                                   Text="Consulta refacciones por nombre, codigo o categoria."
                                   FontSize="14"
                                   Foreground="#6B7785"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" BorderBrush="#D9E2EC" BorderThickness="1" Margin="0,0,0,18">
                        <TextBox x:Name="txtBuscarProductoInicio"
                                 Height="40"
                                 FontSize="15"
                                 Padding="12,8"
                                 TextChanged="TxtBuscarProductoInicio_TextChanged"
                                 KeyDown="TxtBuscarProductoInicio_KeyDown"/>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" BorderBrush="#D9E2EC" BorderThickness="1">
                            <DataGrid x:Name="dgProductosInicio"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      AlternatingRowBackground="#F8FAFC"
                                      SelectionChanged="DgProductosInicio_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoBarras}" Width="130"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="140"/>
                                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat={}{0:C}}" Width="110"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18" BorderBrush="#D9E2EC" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock x:Name="lblProductoInicioNombre" Text="Selecciona un producto" FontSize="19" FontWeight="Bold" Foreground="#1E272E" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="lblProductoInicioDatos" Text="La imagen aparecera aqui." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Image x:Name="imgProductoInicio" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="lblProductoInicioSinImagen"
                                                   Text="Sin imagen disponible"
                                                   Foreground="#94A3B8"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <Button x:Name="btnImagenAnterior"
                                                Content="&lt;"
                                                Width="38"
                                                Height="38"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="BtnImagenAnterior_Click"
                                                Background="#DCE8F6"
                                                Foreground="#1E3A5F"
                                                BorderBrush="#CBD5E1"
                                                FontSize="24"
                                                FontWeight="Bold"/>
                                        <Button x:Name="btnImagenSiguiente"
                                                Content="&gt;"
                                                Width="38"
                                                Height="38"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="BtnImagenSiguiente_Click"
                                                Background="#DCE8F6"
                                                Foreground="#1E3A5F"
                                                BorderBrush="#CBD5E1"
                                                FontSize="24"
                                                FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="lblProductoInicioPrecio" Grid.Row="2" Text="$0.00" FontSize="28" FontWeight="Black" Foreground="#16A34A" Margin="0,16,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
        </Grid>
    </Grid>
</Window>
