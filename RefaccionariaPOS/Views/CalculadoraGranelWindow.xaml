<Window x:Class="RefaccionariaPOS.Views.CalculadoraGranelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calcular venta a granel"
        Height="440"
        Width="470"
        MinHeight="400"
        MinWidth="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F4F6F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Venta a granel" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock x:Name="lblProducto" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="lblPrecioCaption" Text="Precio" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="lblPrecio" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblStockCaption" Text="Disponible" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                    <TextBlock x:Name="lblStock" FontSize="20" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="lblCantidadCaption" Text="Cantidad" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox x:Name="txtCantidad" Height="44" Padding="10,8" FontSize="20" FontWeight="Bold" TextAlignment="Center" Text="1" TextChanged="TxtCantidad_TextChanged"/>
            <TextBlock Text="Puedes usar decimales, por ejemplo: 1.25" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0" VerticalAlignment="Top">
            <DockPanel>
                <TextBlock Text="Total a cobrar" FontSize="16" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblTotal" Text="$0.00" FontSize="26" FontWeight="Black" Foreground="#15803D" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="4" Columns="2" Margin="0,24,0,0">
            <Button Content="Cancelar" Height="42" Margin="5" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnCancelar_Click"/>
            <Button Content="Agregar al carrito" Height="42" Margin="5" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAgregar_Click"/>
        </UniformGrid>
    </Grid>
</Window>
