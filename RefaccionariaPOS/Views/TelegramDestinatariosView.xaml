<Window x:Class="RefaccionariaPOS.Views.TelegramDestinatariosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avisos por Telegram"
        Height="640"
        Width="980"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Avisos por Telegram" FontSize="28" FontWeight="Bold" Foreground="#1E272E"/>
            <TextBlock Text="Chats que reciben un mensaje cada vez que se registra una venta." FontSize="14" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock x:Name="lblModo" Text="Nuevo destinatario" FontSize="18" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,0,16"/>

                    <Button x:Name="btnDetectar" Content="Detectar chat nuevo" Height="40" Margin="0,0,0,4" Background="#229ED9" Foreground="White" FontWeight="Bold" Click="BtnDetectar_Click"/>
                    <TextBlock Text="Pide a la persona que busque el bot en Telegram y le escriba cualquier mensaje. Luego presiona el boton y sus datos se llenan solos."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Chat ID" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtChatId" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre (opcional)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="34" Padding="8,6" Margin="0,0,0,12"/>

                    <CheckBox x:Name="chkActivo" Content="Recibe avisos" IsChecked="True" Margin="0,0,0,16" FontWeight="SemiBold" Foreground="#334155"/>

                    <UniformGrid Columns="2">
                        <Button Content="Guardar" Height="40" Margin="0,0,6,0" Background="#0F766E" Foreground="White" FontWeight="Bold" Click="BtnGuardar_Click"/>
                        <Button Content="Nuevo" Height="40" Margin="6,0,0,0" Background="#64748B" Foreground="White" FontWeight="Bold" Click="BtnNuevo_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button Content="Eliminar" DockPanel.Dock="Right" Width="100" Height="34" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Click="BtnEliminar_Click"/>
                        <Button x:Name="btnAlternar" Content="Activar / Desactivar" DockPanel.Dock="Right" Width="150" Height="34" Margin="0,0,8,0" Background="#2980B9" Foreground="White" FontWeight="SemiBold" Click="BtnAlternar_Click"/>
                        <TextBlock Text="Selecciona un destinatario para editarlo." VerticalAlignment="Center" Foreground="#64748B"/>
                    </DockPanel>

                    <DataGrid x:Name="dgDestinatarios"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="DgDestinatarios_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="160"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="110"/>
                            <DataGridTextColumn Header="Alta" Binding="{Binding FechaAlta, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
