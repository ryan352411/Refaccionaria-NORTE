<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Valores por defecto para que el build no falle si no se pasan con -d.
       En produccion pasalos con: -d WhatsAppToken=... -d WhatsAppPhoneId=... -->
  <?ifndef WhatsAppToken ?>
  <?define WhatsAppToken = "" ?>
  <?endif ?>
  <?ifndef WhatsAppPhoneId ?>
  <?define WhatsAppPhoneId = "" ?>
  <?endif ?>
  <Package Name="RefaxManager" Manufacturer="RefaxManager" Version="1.0.31" UpgradeCode="B1B2335E-2332-4603-BD26-0B3B8865024A" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="Ya existe una version mas reciente de RefaxManager instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="RefaxManagerIcon" SourceFile="builds\RefaxManager\RefaxManager.exe" />
    <Property Id="ARPPRODUCTICON" Value="RefaxManagerIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="RefaxManagerCompanyFolder" Name="RefaxManager">
        <Directory Id="INSTALLFOLDER" Name="RefaxManager" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RefaxManager" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="00C67EC0-0AF9-437A-A937-DE89179711BB">
        <Shortcut Id="DesktopShortcut" Name="RefaxManager" Description="Abrir RefaxManager" Target="[INSTALLFOLDER]RefaxManager.exe" WorkingDirectory="INSTALLFOLDER" Icon="RefaxManagerIcon" />
        <RegistryValue Root="HKCU" Key="Software\RefaxManager\RefaxManager" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationFiles" Guid="CC6DB9B4-2BFC-487F-862F-0D8E04F96BB7">
        <File Id="RefaxManagerExe" Source="builds\RefaxManager\RefaxManager.exe" KeyPath="yes" />
        <Environment Id="NeonConnectionEnvironment" Name="REFACCIONARIA_NUEVA_DB_CONNECTION" Value="$(var.DbConnectionString)" Action="set" Part="all" System="no" />
        <Environment Id="LicenseConnectionEnvironment" Name="REFACCIONARIA_LICENSE_DB_CONNECTION" Value="$(var.LicenseDbConnectionString)" Action="set" Part="all" System="no" />
        <Environment Id="WhatsAppTokenEnvironment" Name="REFAX_WHATSAPP_TOKEN" Value="$(var.WhatsAppToken)" Action="set" Part="all" System="no" />
        <Environment Id="WhatsAppPhoneIdEnvironment" Name="REFAX_WHATSAPP_PHONE_ID" Value="$(var.WhatsAppPhoneId)" Action="set" Part="all" System="no" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="A03E21AC-1F1D-445D-BB58-0867747D902D">
        <Shortcut Id="StartMenuShortcut" Name="RefaxManager" Description="Abrir RefaxManager" Target="[INSTALLFOLDER]RefaxManager.exe" WorkingDirectory="INSTALLFOLDER" Icon="RefaxManagerIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RefaxManager\RefaxManager" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="RefaxManager" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
